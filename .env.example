# cp .env.example .env

# ── Engine (FastAPI, backend/run_local.sh) ──
VITE_ENGINE_API_URL=http://localhost:8000/api
# Local beta token — create it with:  cd backend && python3 seed_token.py
VITE_BETA_TOKEN=LOCALDEV

# ── Firebase (Console -> Project settings -> Your apps -> Web app config) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Supabase (still used by a few older pages) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── AI Vyas backend (optional) ──
VITE_VYAS_API_URL=http://localhost:8000/api/v1

# WARNING: anything with a VITE_ prefix is baked into the public JS bundle.
# These two are exposed to every visitor — move them behind the backend before
# going live, and rotate them afterwards.
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
